@tone = [macronmod uni02CA caron uni02CB];
@tone_w1 = [tone1.w1 tone2.w1 tone3.w1 tone4.w1];
@tone_w2 = [tone1.w2 tone2.w2 tone3.w2 tone4.w2];
@tone_above = [tone1.w1 tone1.w2 tone2.w1 tone2.w2 tone3.w1 tone3.w2 tone4.w1 tone4.w2];

feature calt {
    lookupflag IgnoreMarks;
    sub @letter @letter @tone' by @tone_w2;
    sub @letter @tone' by @tone_w1;
} calt;

