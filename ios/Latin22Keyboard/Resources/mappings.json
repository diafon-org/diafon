        },
        {
          "id": "hu-single",
          "name": "Single chars for palatalized consonants and dz",
          "description": "n̗ l̗ t̗ d̗ s̗ z̗ c̗ via ‑y; palatalized dž (đ̗/Đ̗) via cx or dx.",
