          "id": "hu-vowels",
          "name": "Vowels & dž characters",
          "description": "á é í ó ú via ‑q; ö ü via ‑w; ő ű via ‑x; đ/Đ via cw or dw.",
          "level": 1,
          "modifier_keys": [
            "q",
            "w",
            "x"
          ],
